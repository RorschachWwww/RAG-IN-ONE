# Docker runtime config for bge-m3 embedding service.
# Default behavior uses all visible GPUs on the host.

IMAGE_NAME=rag-in-one/bge-m3-embed:latest

# Set to "all" to start one container per GPU discovered by nvidia-smi.
# You can also provide a comma-separated list, for example:
# GPU_DEVICES=0
# GPU_DEVICES=0,1
# GPU_DEVICES=1,3
GPU_DEVICES=all

# Docker GPU binding mode.
# gpus: default Docker --gpus device=N path.
# runtime: legacy NVIDIA runtime path, equivalent to --runtime nvidia + NVIDIA_VISIBLE_DEVICES=N.
# cdi: Docker CDI path, equivalent to --device nvidia.com/gpu=N. Requires a generated CDI spec.
DOCKER_GPU_MODE=gpus

# If the image is not already loaded locally, set IMAGE_TAR to a saved tar file.
# IMAGE_TAR=/data/images/bge-m3-embed-latest.tar

CONTAINER_PREFIX=bge_m3
HOST_PORT_BASE=18080

EMBEDDING_USE_FP16=true
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_TEXTS=128
EMBEDDING_MAX_CONCURRENT_REQUESTS=1
LOG_LEVEL=INFO
