# Milvus offline runtime config

# Load one tar file when IMAGE_TAR is set.
IMAGE_TAR=

# Otherwise load all *.tar files from IMAGE_TAR_DIR.
IMAGE_TAR_DIR=

COMPOSE_FILE=

# Persistent data directory on host
DOCKER_VOLUME_DIRECTORY=/data/milvus-offline

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MILVUS_GRPC_PORT=19530
MILVUS_HTTP_PORT=9091

MILVUS_NETWORK_NAME=milvus
